#!/bin/sh
[ -d /var/jb/usr/bin ] && ln -sf /var/usr/libexec/iphoneports-shell /var/jb/usr/bin
mkdir -p /usr/local/bin 2>/dev/null && ln -sf /var/usr/libexec/iphoneports-shell /usr/local/bin/iphoneports-shell 2>/dev/null || {
    if ! [ -h /var/usr ]; then
        if [ -d /var/jb ]; then
            mkdir -p /var/jb/iphoneports
            mv /var/usr/* /var/jb/iphoneports
            rm -r /var/usr
            ln -s /var/jb/iphoneports /var/usr
        else
            printf "!!!WARNING!!! rootfs is not writable but /var/jb doesn't exist, problems may arise!\n"
        fi
    fi
}
