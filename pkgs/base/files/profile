PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
[ -d /var/jb/bin ] && PATH="/var/jb/bin:/var/jb/sbin:/var/jb/usr/bin:/var/jb/usr/sbin:$PATH"
[ -d /opt/local/bin ] && PATH="$PATH:/opt/local/bin"
[ -d /opt/homebrew/bin ] && PATH="$PATH:/opt/homebrew/bin:/opt/homebrew/sbin"
export PATH="/var/usr/sbin:/var/usr/bin:$PATH"
umask 022

eval "$(dircolors -b)"

for sh in /var/usr/etc/profile.d/*.sh; do
    [ -r "$sh" ] && . "$sh"
done

if [ -n "$BASH_VERSION" ]; then
    . /var/usr/etc/bash/bashrc
else
    if [ "$(id -u)" = 0 ]; then
        PS1="${USER:-$(id -un 2>/dev/null)}@$(uname -n 2>/dev/null) # "
    else
        PS1="${USER:-$(id -un 2>/dev/null)}@$(uname -n 2>/dev/null) \$ "
    fi
fi
